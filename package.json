{
  "name": "ai-resume-builder",
  "version": "2.0.0",
  "description": "AI-Powered Resume Builder Platform - Multi-user resume creation with LinkedIn-like UX and OpenAI integration",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"nodemon server.js\" \"npm run client\"",
    "client": "npm start --prefix client",
    "build": "npm run build --prefix client",
    "install-all": "npm install && cd client && npm install",
    "heroku-postbuild": "cd client && npm install && npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "resume-builder",
    "ai-resume",
    "linkedin",
    "openai",
    "career",
    "portfolio",
    "resume",
    "professional",
    "mern-stack"
  ],
  "author": {
    "name": "Benjamin Madera Jr",
    "email": "benjamin.maderajr@gmail.com",
    "url": "https://www.linkedin.com/in/benjamin-madera-jr/"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "mongoose": "^8.0.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "express-validator": "^7.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "openai": "^4.24.1",
    "multer": "^1.4.5-lts.1",
    "express-rate-limit": "^7.1.5",
    "validator": "^13.11.0",
    "puppeteer": "^21.7.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/benjaminmaderajr-TMMBA/Tech-Apps.git"
  }
}
